{
  "name": "flat-white",
  "version": "1.1.0",
  "description": "Australian addresses. Flattened and served.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": "^22.22.1 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "generate:sql": "node --experimental-strip-types scripts/generate-main-sql.ts",
    "build": "npm run generate:sql && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixture": "./scripts/build-fixture-only.sh",
    "prepare": "husky || true"
  },
  "homepage": "https://github.com/jbejenar/flat-white",
  "repository": {
    "type": "git",
    "url": "https://github.com/jbejenar/flat-white.git"
  },
  "author": "jbejenar",
  "bugs": {
    "url": "https://github.com/jbejenar/flat-white/issues"
  },
  "keywords": [
    "australia",
    "gnaf",
    "addresses",
    "ndjson",
    "boundaries",
    "geocoding",
    "data-transformation",
    "open-data"
  ],
  "dependencies": {
    "@dsnp/parquetjs": "1.9.4",
    "postgres": "^3.4.9",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "license": "Apache-2.0",
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
