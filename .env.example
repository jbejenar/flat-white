# flat-white environment examples. See docs/RELEASING.md.
# Schema 1.0.0 uses ASGS 2026; production sources must be compatible.
# Do not use this production version for the frozen fixture build:
# leave GNAF_VERSION unset when running ./scripts/build-fixture-only.sh.

# PostgreSQL for local tooling; production Postgres lives inside the container.
# Fixture scripts choose their own host port unless POSTGRES_PORT is set.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gnaf

# Source archives extract beneath DATA_DIR.
DATA_DIR=./data

# Optional explicit paths must match DATA_DIR and the selected source quarter.
# Leave these unset to use downloader-derived paths.
# GNAF_DATA_PATH=./data/G-NAF
# ADMIN_BDYS_PATH=./data/AUG26_AdminBounds_GDA_2020_SHP

# Production source quarter, not schema version or release patch number.
GNAF_VERSION=2026.08
# Docker state selection uses flags: --states VIC NSW (space-separated).
# Direct module invocation also reads its documented environment variables.
STATES=VIC
OUTPUT_DIR=./output

# Optional manual sources. Workflow overrides must be supplied together with
# gnaf_version; consult docs/RELEASING.md before using them.
# DOWNLOAD_URL_GNAF=https://...
# DOWNLOAD_URL_ADMIN_BDYS=https://...
# ADMIN_BDYS_EXTRACTED_DIR=AUG26_AdminBounds_GDA_2020_SHP
